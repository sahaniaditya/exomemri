{
  "name": "atlas-extension",
  "displayName": "exomemri",
  "version": "0.1.0",
  "description": "exomemri capture extension — one-click capture of what you learn online into a Learning Space.",
  "author": "exomemri",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "gen:types": "openapi-typescript ../backend/openapi.json -o src/lib/types.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@webext-core/messaging": "^3.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wxt": "^0.20.27"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
