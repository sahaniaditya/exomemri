{
  "components": {
    "schemas": {
      "CaptureRequest": {
        "description": "Payload the extension background worker POSTs to ``/v1/sources``.\n\n``content`` carries small text payloads (a YouTube transcript JSON string,\nan AI-chat thread JSON string, or an article's cleaned text). ``raw_html``\nis an optional companion for articles so the server can persist both\n``raw/page.html`` and ``raw/extracted.txt`` (design \u00a72.4 capture table).\nLarge binary sources (PDF) do not use this endpoint \u2014 see\n``/v1/sources/upload-url``.",
        "properties": {
          "anchor": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchor"
          },
          "author": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "content_hash": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "raw_html": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Html"
          },
          "space_id": {
            "format": "uuid",
            "title": "Space Id",
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "space_id",
          "type",
          "title"
        ],
        "title": "CaptureRequest",
        "type": "object"
      },
      "CaptureResponse": {
        "properties": {
          "processing_status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "processing_status"
        ],
        "title": "CaptureResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProcessingStatus": {
        "description": "Lifecycle of a source.\n\nPhase 0 only ever emits ``queued`` (nothing processes it yet); the full\nset is declared here so the generated client contract is stable across\nphases.",
        "enum": [
          "queued",
          "fetching",
          "chunking",
          "embedding",
          "summarizing",
          "extracting",
          "ready",
          "failed"
        ],
        "title": "ProcessingStatus",
        "type": "string"
      },
      "SessionResponse": {
        "description": "Current user + the active learning space (may be null).",
        "properties": {
          "active_space": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Space"
              },
              {
                "type": "null"
              }
            ]
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SetActiveSpaceRequest": {
        "properties": {
          "space_id": {
            "format": "uuid",
            "title": "Space Id",
            "type": "string"
          }
        },
        "required": [
          "space_id"
        ],
        "title": "SetActiveSpaceRequest",
        "type": "object"
      },
      "SourceType": {
        "description": "The kind of artifact being captured.",
        "enum": [
          "youtube",
          "article",
          "ai_chat",
          "pdf",
          "note"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "Space": {
        "description": "A goal-scoped Learning Space.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Space",
        "type": "object"
      },
      "UploadUrlRequest": {
        "description": "Request a pre-signed upload for a large binary source (PDF).",
        "properties": {
          "author": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "content_hash": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "space_id": {
            "format": "uuid",
            "title": "Space Id",
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "space_id",
          "title"
        ],
        "title": "UploadUrlRequest",
        "type": "object"
      },
      "UploadUrlResponse": {
        "description": "A tokenized Supabase upload URL the client PUTs the file to.\n\nNote: this is NOT an S3 pre-signed PUT. The client PUTs the bytes to\n``upload_url`` with header ``x-upsert: true``; ``token`` authorizes it.\nSingle-use, short-lived.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "processing_status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          },
          "upload_url": {
            "title": "Upload Url",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "processing_status",
          "upload_url",
          "token",
          "path"
        ],
        "title": "UploadUrlResponse",
        "type": "object"
      },
      "User": {
        "description": "The authenticated user (Phase 0: a fixed dev user).",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "User",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Phase 0 thin capture endpoint: writes raw artifacts to Supabase Storage.",
    "title": "Atlas Capture API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/v1/session": {
      "get": {
        "operationId": "get_session_v1_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Session",
        "tags": [
          "session"
        ]
      }
    },
    "/v1/session/active": {
      "post": {
        "operationId": "set_active_space_v1_session_active_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetActiveSpaceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Active Space",
        "tags": [
          "session"
        ]
      }
    },
    "/v1/sources": {
      "post": {
        "operationId": "capture_source_v1_sources_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Capture Source",
        "tags": [
          "sources"
        ]
      }
    },
    "/v1/sources/upload-url": {
      "post": {
        "operationId": "create_upload_url_v1_sources_upload_url_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadUrlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadUrlResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Upload Url",
        "tags": [
          "sources"
        ]
      }
    }
  }
}
