{
  "components": {
    "schemas": {
      "ArtifactUrlResponse": {
        "description": "A short-lived signed GET URL for one artifact in the private bucket.",
        "properties": {
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expires_in"
        ],
        "title": "ArtifactUrlResponse",
        "type": "object"
      },
      "AuthUser": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "AuthUser",
        "type": "object"
      },
      "CaptureRequest": {
        "description": "Payload the extension background worker POSTs to ``/v1/sources``.\n\n``content`` carries small text payloads (a YouTube transcript JSON string,\nan AI-chat thread JSON string, or an article's cleaned text). ``raw_html``\nis an optional companion for articles so the server can persist both\n``raw/page.html`` and ``raw/extracted.txt`` (design \u00a72.4 capture table).\nLarge binary sources (PDF) do not use this endpoint \u2014 see\n``/v1/sources/upload-url``.",
        "properties": {
          "anchor": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchor"
          },
          "author": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "content_hash": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "raw_html": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Html"
          },
          "space_id": {
            "format": "uuid",
            "title": "Space Id",
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "space_id",
          "type",
          "title"
        ],
        "title": "CaptureRequest",
        "type": "object"
      },
      "CaptureResponse": {
        "properties": {
          "processing_status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "processing_status"
        ],
        "title": "CaptureResponse",
        "type": "object"
      },
      "ChatMessage": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "CreateSpaceRequest": {
        "description": "Payload for creating a Learning Space, e.g. ``{\"name\": \"Claude Code\"}``.",
        "properties": {
          "goal_text": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal Text"
          },
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateSpaceRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "user"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "MessageListResponse": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "messages"
        ],
        "title": "MessageListResponse",
        "type": "object"
      },
      "MessageResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "OnboardingStatusResponse": {
        "properties": {
          "has_completed_onboarding": {
            "title": "Has Completed Onboarding",
            "type": "boolean"
          }
        },
        "required": [
          "has_completed_onboarding"
        ],
        "title": "OnboardingStatusResponse",
        "type": "object"
      },
      "ProcessingStatus": {
        "description": "Lifecycle of a source.\n\nPhase 0 only ever emits ``queued`` (nothing processes it yet); the full\nset is declared here so the generated client contract is stable across\nphases.",
        "enum": [
          "queued",
          "fetching",
          "chunking",
          "embedding",
          "summarizing",
          "extracting",
          "ready",
          "failed"
        ],
        "title": "ProcessingStatus",
        "type": "string"
      },
      "ProfileUpsertRequest": {
        "description": "Onboarding/profile write payload.",
        "properties": {
          "domain_of_focus": {
            "title": "Domain Of Focus",
            "type": "string"
          },
          "full_name": {
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "primary_role": {
            "title": "Primary Role",
            "type": "string"
          },
          "referral_source": {
            "title": "Referral Source",
            "type": "string"
          },
          "username": {
            "minLength": 3,
            "pattern": "^[a-z0-9_]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "full_name",
          "username",
          "primary_role",
          "domain_of_focus",
          "referral_source"
        ],
        "title": "ProfileUpsertRequest",
        "type": "object"
      },
      "SendMessageRequest": {
        "properties": {
          "content": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "SendMessageRequest",
        "type": "object"
      },
      "SendMessageResponse": {
        "properties": {
          "assistant_message": {
            "$ref": "#/components/schemas/ChatMessage"
          },
          "user_message": {
            "$ref": "#/components/schemas/ChatMessage"
          }
        },
        "required": [
          "user_message",
          "assistant_message"
        ],
        "title": "SendMessageResponse",
        "type": "object"
      },
      "SessionResponse": {
        "description": "Current user + the active learning space (may be null).",
        "properties": {
          "active_space": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Space"
              },
              {
                "type": "null"
              }
            ]
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SetActiveSpaceRequest": {
        "properties": {
          "space_id": {
            "format": "uuid",
            "title": "Space Id",
            "type": "string"
          }
        },
        "required": [
          "space_id"
        ],
        "title": "SetActiveSpaceRequest",
        "type": "object"
      },
      "SourceCounts": {
        "description": "Per-type capture counts for a space, as returned by the counts RPC.",
        "properties": {
          "ai_chat": {
            "default": 0,
            "title": "Ai Chat",
            "type": "integer"
          },
          "article": {
            "default": 0,
            "title": "Article",
            "type": "integer"
          },
          "note": {
            "default": 0,
            "title": "Note",
            "type": "integer"
          },
          "pdf": {
            "default": 0,
            "title": "Pdf",
            "type": "integer"
          },
          "total": {
            "default": 0,
            "title": "Total",
            "type": "integer"
          },
          "youtube": {
            "default": 0,
            "title": "Youtube",
            "type": "integer"
          }
        },
        "title": "SourceCounts",
        "type": "object"
      },
      "SourceListResponse": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceSummary"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "sources"
        ],
        "title": "SourceListResponse",
        "type": "object"
      },
      "SourceSummary": {
        "description": "A captured source. ``storage_prefix`` is deliberately not exposed \u2014\nartifacts are reached through ``GET /v1/sources/{id}/artifact-url``.",
        "properties": {
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "captured_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captured At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "processing_status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "space_id": {
            "format": "uuid",
            "title": "Space Id",
            "type": "string"
          },
          "space_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Space Name"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "id",
          "space_id",
          "type",
          "title",
          "processing_status"
        ],
        "title": "SourceSummary",
        "type": "object"
      },
      "SourceType": {
        "description": "The kind of artifact being captured.",
        "enum": [
          "youtube",
          "article",
          "ai_chat",
          "pdf",
          "note"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "Space": {
        "description": "A goal-scoped Learning Space (the identity slice embedded in a session).",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Space",
        "type": "object"
      },
      "SpaceListResponse": {
        "properties": {
          "spaces": {
            "items": {
              "$ref": "#/components/schemas/SpaceSummary"
            },
            "title": "Spaces",
            "type": "array"
          }
        },
        "required": [
          "spaces"
        ],
        "title": "SpaceListResponse",
        "type": "object"
      },
      "SpaceSummary": {
        "description": "A space plus enough aggregate detail to render a dashboard tile.",
        "properties": {
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "goal_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal Text"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_captured_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Captured At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "source_counts": {
            "$ref": "#/components/schemas/SourceCounts",
            "default": {
              "ai_chat": 0,
              "article": 0,
              "note": 0,
              "pdf": 0,
              "total": 0,
              "youtube": 0
            }
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ],
        "title": "SpaceSummary",
        "type": "object"
      },
      "SummaryResponse": {
        "properties": {
          "generated": {
            "title": "Generated",
            "type": "boolean"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "summarized_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summarized At"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "summary",
          "generated",
          "model",
          "summarized_at"
        ],
        "title": "SummaryResponse",
        "type": "object"
      },
      "UploadUrlRequest": {
        "description": "Request a pre-signed upload for a large binary source (PDF).",
        "properties": {
          "author": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "content_hash": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Hash"
          },
          "space_id": {
            "format": "uuid",
            "title": "Space Id",
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "space_id",
          "title"
        ],
        "title": "UploadUrlRequest",
        "type": "object"
      },
      "UploadUrlResponse": {
        "description": "A tokenized Supabase upload URL the client PUTs the file to.\n\nNote: this is NOT an S3 pre-signed PUT. The client PUTs the bytes to\n``upload_url`` with header ``x-upsert: true``; ``token`` authorizes it.\nSingle-use, short-lived.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "processing_status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          },
          "upload_url": {
            "title": "Upload Url",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "processing_status",
          "upload_url",
          "token",
          "path"
        ],
        "title": "UploadUrlResponse",
        "type": "object"
      },
      "User": {
        "description": "The authenticated user.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "User",
        "type": "object"
      },
      "UserLogin": {
        "description": "Payload when a user signs in.",
        "properties": {
          "email": {
            "examples": [
              "user@atlas-app.com"
            ],
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "UserLogin",
        "type": "object"
      },
      "UsernameAvailabilityResponse": {
        "properties": {
          "is_taken": {
            "title": "Is Taken",
            "type": "boolean"
          }
        },
        "required": [
          "is_taken"
        ],
        "title": "UsernameAvailabilityResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Phase 0 thin capture endpoint: writes raw artifacts to Supabase Storage.",
    "title": "Atlas Capture API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/v1/auth/check-username": {
      "get": {
        "operationId": "check_username_v1_auth_check_username_get",
        "parameters": [
          {
            "in": "query",
            "name": "username",
            "required": true,
            "schema": {
              "minLength": 3,
              "pattern": "^[a-z0-9_]+$",
              "title": "Username",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsernameAvailabilityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Username",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "login_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout_v1_auth_logout_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
